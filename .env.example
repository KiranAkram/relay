# Copy to .env and adjust. Values here are safe placeholders for local dev and CI;
# the app warns on "changethis" in development and refuses to start elsewhere.
FASTAPI_ENV=development
PROJECT_NAME="Relay"

# Backend
SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Access: accounts are created by an admin. Self-registration stays off.
USERS_OPEN_REGISTRATION=false
# Demo doctor account (seeded at start-up); banner shows it on the login page.
DEMO_DOCTOR_EMAIL=doctor@example.com
DEMO_DOCTOR_PASSWORD=changethis
DEMO_ACCESS_BANNER=true

# Emails
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TLS=False
EMAILS_FROM_EMAIL=info@example.com

# Postgres
POSTGRES_PASSWORD=changethis
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/app

# Extraction (LLM). Keep `fake` in CI; locally set `openai` and a key.
LLM_PROVIDER=fake
OPENAI_API_KEY=
LLM_MODEL=gpt-5-mini
EXTRACTION_PROMPT_VERSION=v2
HOSPITAL_TIMEZONE=Asia/Karachi

# Speech-to-text (same OPENAI_API_KEY)
STT_PROVIDER=fake
STT_MODEL=gpt-transcribe

# Intent gate: is the transcript a clinical shift handover? fake | jev
# (TypeSafe AI). Below the threshold the handover is rejected, no cards.
INTENT_PROVIDER=fake
INTENT_MODEL=jev-latest
INTENT_THRESHOLD=0.8
TYPESAFE_API_KEY=

# Recordings and pipeline jobs
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=data
JOB_RUNNER=inprocess

# Alerts: minutes before a task is due that its "due soon" flag fires
ALERT_LEAD_MINUTES=15

# Demo limits: recording cut at this many seconds; recordings per visitor
# (signed cookie, and per IP address) per day; audio minutes transcribed per
# day across everyone. Days roll over at midnight in HOSPITAL_TIMEZONE.
RECORDING_MAX_SECONDS=120
VISITOR_RECORDINGS_PER_DAY=3
TRANSCRIPTION_MINUTES_PER_DAY=30

# Logging: JSON lines outside development. DEBUG only by hand.
LOG_LEVEL=INFO
